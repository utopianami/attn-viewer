{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "keys"],
        "properties": {
          "slug": { "type": "string" },
          "keys": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 3,
            "maxItems": 12
          }
        }
      }
    }
  }
}
