{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "covered", "hasKill", "killCovered"],
        "properties": {
          "order": { "type": "integer" },
          "covered": { "type": "boolean" },
          "hasKill": { "type": "boolean" },
          "killCovered": { "type": "boolean" }
        }
      }
    }
  }
}
